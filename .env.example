# LLM Provider Configuration
# Supported: offline (deterministic mock for CI/evals), gemini (Google Gemini frontier), openai, ollama
LLM_MODE=offline

# Frontier API Keys (Required when LLM_MODE=gemini or LLM_MODE=openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Names
GEMINI_MODEL=gemini-3.6-pro-latest
OPENAI_MODEL=gpt-4o

# MCP (Model Context Protocol) Server & Client Configuration
MCP_TRANSPORT=stdio
MCP_PORT=8001
MCP_HOST=127.0.0.1

# Paths & Directories
DATA_DIR=data
CONFIG_PATH=config/default_config.yaml
POLICIES_PATH=config/policies.yaml
SQLITE_DB_PATH=data/storage/copilot_memory.sqlite

# System Governance & Risk Thresholds
MAX_REFLECTIVE_LOOPS=2
GROUNDING_THRESHOLD=0.75
ENABLE_PII_REDACTION=true
ENABLE_INJECTION_DEFENSE=true
LOG_LEVEL=INFO
